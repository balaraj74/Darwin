# Darwin Backend — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ─── Google Cloud / Vertex AI ─────────────────────────────────────────────────
GCP_PROJECT=darwinagent
GCP_LOCATION=asia-south1
FIREBASE_PROJECT_ID=darwinagent
FIREBASE_STORAGE_BUCKET=darwinagent.firebasestorage.app

# ─── Aerolink — PRIMARY AI provider (Anthropic Claude via proxy) ──────────────
AEROLINK_API_KEY=your_aerolink_api_key_here
AEROLINK_BASE_URL=https://capi.aerolink.lat/

# ─── Gemini (legacy, optional) ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── NVIDIA NIM — fallback 3 ──────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_API_KEY_SECONDARY=your_nvidia_key_secondary_here
NVIDIA_API_KEY_KIMI=your_nvidia_kimi_key_here

# ─── OpenRouter — fallback 4 ──────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_SECONDARY=your_openrouter_key_secondary_here

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:3001
